<Window x:Class="KidLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KidLauncher" WindowStyle="None" ResizeMode="NoResize"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#14233B"
 ShowInTaskbar="False" FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True">
 <Window.Resources>
  <RadialGradientBrush x:Key="SoftGlow">
   <GradientStop Color="#55FFF1CD" Offset="0"/><GradientStop Color="#1AFFF1CD" Offset="0.55"/><GradientStop Color="#00FFF1CD" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="HeadGlow">
   <GradientStop Color="#C0FFF6DC" Offset="0"/><GradientStop Color="#40FFF1CD" Offset="0.45"/><GradientStop Color="#00FFF1CD" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="FireflyGlow">
   <GradientStop Color="#FFFFF8D2" Offset="0"/><GradientStop Color="#FFF7E58A" Offset="0.22"/><GradientStop Color="#55F7E58A" Offset="0.5"/><GradientStop Color="#00F7E58A" Offset="1"/>
  </RadialGradientBrush>
  <Style x:Key="SkyFocus" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
    <Border Margin="4" BorderBrush="#F4DFAC" BorderThickness="2" CornerRadius="20"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SkyToy" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource SkyFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Backdrop" Focusable="True">
  <Grid x:Name="BackdropAccents" ClipToBounds="True">
   <Rectangle IsHitTestVisible="False">
    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#303F285E" Offset="0"/><GradientStop Color="#805D487C" Offset="0.65"/><GradientStop Color="#A07A637D" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
   </Rectangle>
   <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
    <Canvas Width="1920" Height="1080">
     <!-- Still, resolution-independent scenery; no render loop, blur or particle field. -->
     <Path Fill="#13C5B2D8" Data="M0,890 Q290,680 620,880 Q960,1040 1230,830 Q1580,620 1920,820 L1920,1080 L0,1080Z"/>
     <Path Fill="#16332753" Data="M0,1000 Q340,790 740,980 Q1130,1130 1500,910 Q1720,800 1920,970 L1920,1080 L0,1080Z"/>
     <Path Stroke="#37EAD9B0" StrokeThickness="1" Data="M1410,294 L1480,242 1512,314"/>
     <Path Fill="#BDEAD9B0" Data="M1509,311 L1512,301 1515,311 1525,314 1515,317 1512,327 1509,317 1499,314Z"/>
     <Ellipse Canvas.Left="1407" Canvas.Top="291" Width="5" Height="5" Fill="#90EAD9B0"/>
     <Ellipse Canvas.Left="1477" Canvas.Top="239" Width="6" Height="6" Fill="#D5EAD9B0"/>
     <Path Fill="#68F4E4C7" Data="M660,98 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M1050,180 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M1180,82 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M1780,356 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M94,460 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"/>
     <!-- Ambient twinkle: opacity only, kept out of the moon, constellation and shooting-star paths. -->
     <Canvas x:Name="Twinkles">
      <Canvas Canvas.Left="686" Canvas.Top="36" Opacity="0.6"><Ellipse Width="28" Height="28" Fill="{StaticResource SoftGlow}"/><Path Canvas.Left="8" Canvas.Top="8" Fill="#FFF1CD" Data="M6,0 L7.5,4.5 12,6 7.5,7.5 6,12 4.5,7.5 0,6 4.5,4.5Z"/></Canvas>
      <Canvas Canvas.Left="1231" Canvas.Top="31" Opacity="0.6"><Ellipse Width="18" Height="18" Fill="{StaticResource SoftGlow}"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FFF1CD"/></Canvas>
      <Canvas Canvas.Left="991" Canvas.Top="11" Opacity="0.6"><Ellipse Width="18" Height="18" Fill="{StaticResource SoftGlow}"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FFF1CD"/></Canvas>
      <Canvas Canvas.Left="266" Canvas.Top="406" Opacity="0.6"><Ellipse Width="28" Height="28" Fill="{StaticResource SoftGlow}"/><Path Canvas.Left="8" Canvas.Top="8" Fill="#FFF1CD" Data="M6,0 L7.5,4.5 12,6 7.5,7.5 6,12 4.5,7.5 0,6 4.5,4.5Z"/></Canvas>
      <Canvas Canvas.Left="1606" Canvas.Top="416" Opacity="0.6"><Ellipse Width="28" Height="28" Fill="{StaticResource SoftGlow}"/><Path Canvas.Left="8" Canvas.Top="8" Fill="#FFF1CD" Data="M6,0 L7.5,4.5 12,6 7.5,7.5 6,12 4.5,7.5 0,6 4.5,4.5Z"/></Canvas>
      <Canvas Canvas.Left="411" Canvas.Top="281" Opacity="0.6"><Ellipse Width="18" Height="18" Fill="{StaticResource SoftGlow}"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FFF1CD"/></Canvas>
      <Canvas Canvas.Left="1071" Canvas.Top="291" Opacity="0.6"><Ellipse Width="18" Height="18" Fill="{StaticResource SoftGlow}"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FFF1CD"/></Canvas>
      <Canvas Canvas.Left="1836" Canvas.Top="236" Opacity="0.6"><Ellipse Width="28" Height="28" Fill="{StaticResource SoftGlow}"/><Path Canvas.Left="8" Canvas.Top="8" Fill="#FFF1CD" Data="M6,0 L7.5,4.5 12,6 7.5,7.5 6,12 4.5,7.5 0,6 4.5,4.5Z"/></Canvas>
      <Canvas Canvas.Left="1781" Canvas.Top="631" Opacity="0.6"><Ellipse Width="18" Height="18" Fill="{StaticResource SoftGlow}"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#FFF1CD"/></Canvas>
      <Canvas Canvas.Left="126" Canvas.Top="626" Opacity="0.6"><Ellipse Width="28" Height="28" Fill="{StaticResource SoftGlow}"/><Path Canvas.Left="8" Canvas.Top="8" Fill="#FFF1CD" Data="M6,0 L7.5,4.5 12,6 7.5,7.5 6,12 4.5,7.5 0,6 4.5,4.5Z"/></Canvas>
     </Canvas>
     <Path Stroke="#45E0C4BB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M86,1080 Q60,960 142,848 M86,1010 Q28,975 26,934 M95,960 Q149,960 178,911 M116,895 Q76,861 84,825 M1810,1080 Q1860,1000 1828,932 M1838,1024 Q1784,1003 1776,973 M1840,990 Q1880,978 1892,944"/>
    </Canvas>
   </Viewbox>
   <Button x:Name="WishingStars" Style="{StaticResource SkyToy}" Width="240" Height="120" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,65,0,0"
    KeyboardNavigation.TabIndex="1001" AutomationProperties.Name="Stars" Click="Stars_Click">
    <Canvas Width="240" Height="120" IsHitTestVisible="False">
     <Ellipse Canvas.Left="2.0" Canvas.Top="60.0" Width="40" Height="40" Fill="{StaticResource SoftGlow}"/>
     <Ellipse Canvas.Left="88.0" Canvas.Top="44.0" Width="30" Height="30" Fill="{StaticResource SoftGlow}"/>
     <Ellipse Canvas.Left="107.0" Canvas.Top="-1.0" Width="44" Height="44" Fill="{StaticResource SoftGlow}"/>
     <Ellipse Canvas.Left="175.0" Canvas.Top="23.0" Width="24" Height="24" Fill="{StaticResource SoftGlow}"/>
     <Path x:Name="StarThread" Stroke="#EAD9B0" Opacity="0.22" StrokeThickness="1" StrokeLineJoin="Round" Data="M22,80 L63,51 103,59 129,21 187,35 207,89"/>
     <!-- The line is about 251px long. Dash units are multiples of the 2px stroke, so a 130-unit dash
          animated from offset 130 to 0 draws it once. -->
     <Path x:Name="StarTrace" Stroke="#FFF1CD" Opacity="0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
      StrokeDashArray="130 130" Data="M22,80 L63,51 103,59 129,21 187,35 207,89"/>
     <Ellipse Canvas.Left="44" Canvas.Top="98" Width="3" Height="3" Fill="#90EAD9B0"/>
     <Ellipse Canvas.Left="161" Canvas.Top="70" Width="2.5" Height="2.5" Fill="#70EAD9B0"/>
     <Ellipse Canvas.Left="226" Canvas.Top="8" Width="3.5" Height="3.5" Fill="#A0EAD9B0"/>
     <Path x:Name="StarOne" Canvas.Left="12.0" Canvas.Top="70.0" Width="20" Height="20" Stretch="Uniform" Fill="#EAD9B0" Opacity="0.85" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="8"/></TransformGroup></Path.RenderTransform>
     </Path>
     <Path x:Name="StarTwo" Canvas.Left="57.5" Canvas.Top="45.5" Width="11" Height="11" Stretch="Uniform" Fill="#F4E6C4" Opacity="0.7" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="-14"/></TransformGroup></Path.RenderTransform>
     </Path>
     <Path x:Name="StarThree" Canvas.Left="95.5" Canvas.Top="51.5" Width="15" Height="15" Stretch="Uniform" Fill="#EAD9B0" Opacity="0.8" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="22"/></TransformGroup></Path.RenderTransform>
     </Path>
     <Path x:Name="StarFour" Canvas.Left="117.5" Canvas.Top="9.5" Width="23" Height="23" Stretch="Uniform" Fill="#FFF1CD" Opacity="0.95" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="-6"/></TransformGroup></Path.RenderTransform>
     </Path>
     <Path x:Name="StarFive" Canvas.Left="181.0" Canvas.Top="29.0" Width="12" Height="12" Stretch="Uniform" Fill="#F4E6C4" Opacity="0.75" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="16"/></TransformGroup></Path.RenderTransform>
     </Path>
     <Path x:Name="StarSix" Canvas.Left="202.5" Canvas.Top="84.5" Width="9" Height="9" Stretch="Uniform" Fill="#EAD9B0" Opacity="0.65" Data="M12,0 L14.6,9.4 24,12 14.6,14.6 12,24 9.4,14.6 0,12 9.4,9.4Z" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform Angle="-20"/></TransformGroup></Path.RenderTransform>
     </Path>
    </Canvas>
   </Button>
   <Button x:Name="Moon" Style="{StaticResource SkyToy}" Width="144" Height="144" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,60,0"
    KeyboardNavigation.TabIndex="1000" AutomationProperties.Name="Moon" Click="Moon_Click">
    <Grid Width="144" Height="144" IsHitTestVisible="False">
     <Ellipse x:Name="MoonGlow" Width="144" Height="144" Fill="{StaticResource SoftGlow}"/>
     <Ellipse x:Name="MoonHalo" Width="132" Height="132" Stroke="#F4DFAC" StrokeThickness="1" Opacity="0"/>
     <Grid x:Name="MoonBody" Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/></TransformGroup></Grid.RenderTransform>
      <Path Stretch="Uniform" Fill="#FFF1CD" Data="M1640,110 A62,62 0 1 0 1718,188 A68,68 0 0 1 1640,110Z"/>
      <!-- Craters stay inside the crescent: geometry bounds 1597..1718 map to 0..104. -->
      <Canvas Opacity="0.55">
       <Ellipse Canvas.Left="21" Canvas.Top="62" Width="14" Height="14" Fill="#EBD3A0"/>
       <Ellipse Canvas.Left="46" Canvas.Top="83" Width="9" Height="9" Fill="#EBD3A0"/>
       <Ellipse Canvas.Left="10" Canvas.Top="38" Width="10" Height="10" Fill="#EBD3A0"/>
      </Canvas>
     </Grid>
    </Grid>
   </Button>
   <Button x:Name="Owl" Style="{StaticResource SkyToy}" Width="110" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="150,0,0,20"
    KeyboardNavigation.TabIndex="1002" AutomationProperties.Name="Owl" Click="Owl_Click">
    <Canvas Width="110" Height="120" IsHitTestVisible="False">
     <Path Stroke="#8C7A8E" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,106 Q52,96 106,104"/>
     <Path Fill="#9CC4A9" Data="M84,102 Q96,86 106,90 Q100,104 84,102Z M14,104 Q6,90 14,84 Q22,94 14,104Z"/>
     <Canvas x:Name="OwlBird" Width="110" Height="120" RenderTransformOrigin="0.5,0.85">
      <Canvas.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/><TranslateTransform/></TransformGroup></Canvas.RenderTransform>
      <Path x:Name="OwlWingLeft" Fill="#7461A2" Data="M32,54 Q16,72 24,94 Q36,86 40,62Z" RenderTransformOrigin="0.8,0.1">
       <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
      </Path>
      <Path x:Name="OwlWingRight" Fill="#7461A2" Data="M78,54 Q94,72 86,94 Q74,86 70,62Z" RenderTransformOrigin="0.2,0.1">
       <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
      </Path>
      <Path Fill="#9884C2" Data="M34,42 L31,22 L47,34Z M76,42 L79,22 L63,34Z M55,30 C78,30 84,52 82,72 C80,92 68,101 55,101 C42,101 30,92 28,72 C26,52 32,30 55,30Z"/>
      <Ellipse Canvas.Left="40" Canvas.Top="63" Width="30" Height="33" Fill="#E9DFF3"/>
      <Path Stroke="#C6B5DF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M46,73 Q49,76 52,73 M58,73 Q61,76 64,73 M52,82 Q55,85 58,82"/>
      <Ellipse Canvas.Left="33" Canvas.Top="38" Width="23" Height="23" Fill="#F7EFDF"/>
      <Ellipse Canvas.Left="54" Canvas.Top="38" Width="23" Height="23" Fill="#F7EFDF"/>
      <Path x:Name="OwlSleep" Stroke="#4A3A5C" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M39,50 Q44.5,55 50,50 M60,50 Q65.5,55 71,50"/>
      <Canvas x:Name="OwlEyes" Opacity="0">
       <Ellipse Canvas.Left="38.5" Canvas.Top="43.5" Width="12" Height="12" Fill="#4A3A5C"/>
       <Ellipse Canvas.Left="59.5" Canvas.Top="43.5" Width="12" Height="12" Fill="#4A3A5C"/>
       <Ellipse Canvas.Left="41.5" Canvas.Top="45.5" Width="4" Height="4" Fill="White"/>
       <Ellipse Canvas.Left="62.5" Canvas.Top="45.5" Width="4" Height="4" Fill="White"/>
      </Canvas>
      <Path Fill="#E8B879" Data="M51.5,57 L58.5,57 L55,63Z"/>
      <Path Stroke="#E8B879" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M46,99 V104 M50,99 V104 M60,99 V104 M64,99 V104"/>
     </Canvas>
     <Canvas x:Name="OwlDreams" Opacity="0.75">
      <TextBlock Canvas.Left="80" Canvas.Top="20" Text="z" FontSize="15" FontWeight="SemiBold" Foreground="#E3D8F0"/>
      <TextBlock Canvas.Left="91" Canvas.Top="2" Text="z" FontSize="20" FontWeight="SemiBold" Foreground="#E3D8F0"/>
     </Canvas>
    </Canvas>
   </Button>
   <Button x:Name="Fireflies" Style="{StaticResource SkyToy}" Width="150" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,20"
    KeyboardNavigation.TabIndex="1003" AutomationProperties.Name="Fireflies" Click="Fireflies_Click">
    <Canvas Width="150" Height="100" IsHitTestVisible="False">
     <Path Stroke="#86AE95" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"
      Data="M20,100 Q22,80 14,66 M28,100 Q32,76 40,64 M60,100 Q58,82 66,72 M92,100 Q96,78 88,62 M104,100 Q108,84 120,76 M132,100 Q130,86 138,74"/>
     <Ellipse Canvas.Left="9" Canvas.Top="60" Width="10" Height="10" Fill="#F2C6D6"/>
     <Ellipse Canvas.Left="83" Canvas.Top="56" Width="10" Height="10" Fill="#F4DFAC"/>
     <Ellipse Canvas.Left="133" Canvas.Top="68" Width="9" Height="9" Fill="#CFC5E6"/>
     <Ellipse x:Name="Firefly1" Canvas.Left="27" Canvas.Top="38" Width="16" Height="16" Fill="{StaticResource FireflyGlow}" Opacity="0.55"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Firefly2" Canvas.Left="66" Canvas.Top="24" Width="16" Height="16" Fill="{StaticResource FireflyGlow}" Opacity="0.55"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Firefly3" Canvas.Left="110" Canvas.Top="40" Width="16" Height="16" Fill="{StaticResource FireflyGlow}" Opacity="0.55"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Firefly4" Canvas.Left="46" Canvas.Top="62" Width="14" Height="14" Fill="{StaticResource FireflyGlow}" Opacity="0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Firefly5" Canvas.Left="94" Canvas.Top="60" Width="14" Height="14" Fill="{StaticResource FireflyGlow}" Opacity="0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Firefly6" Canvas.Left="124" Canvas.Top="58" Width="14" Height="14" Fill="{StaticResource FireflyGlow}" Opacity="0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
    </Canvas>
   </Button>
   <Canvas IsHitTestVisible="False">
    <Canvas x:Name="ShootingStar" Width="160" Height="40" Opacity="0">
     <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
     <Path StrokeThickness="2" StrokeStartLineCap="Round" Data="M12,18 L145,0">
      <Path.Stroke><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#F4DFAC" Offset="0"/><GradientStop Color="#00F4DFAC" Offset="1"/></LinearGradientBrush></Path.Stroke>
     </Path>
     <Ellipse Canvas.Left="-8" Canvas.Top="-2" Width="40" Height="40" Fill="{StaticResource HeadGlow}"/>
     <Path Fill="#FFF1CD" Data="M12,6 L15,15 24,18 15,21 12,30 9,21 0,18 9,15Z"/>
    </Canvas>
   </Canvas>
  </Grid>
  <Grid Margin="48,48,48,36" x:Name="PlayRoom">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <UniformGrid x:Name="Tiles" Columns="4" Rows="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
   <Grid x:Name="Navigation" Grid.Row="1" Margin="12,24,12,0" Height="64">
    <Button x:Name="Previous" Content="‹" FontSize="36" Background="#665A4B72" HorizontalAlignment="Left" Width="88" Padding="0" Click="Previous_Click" AutomationProperties.Name="Previous page" />
    <Button x:Name="Next" Content="›" FontSize="36" Background="#665A4B72" HorizontalAlignment="Right" Width="88" Padding="0" Click="Next_Click" AutomationProperties.Name="Next page" />
   </Grid>
  </Grid>
  <Border x:Name="Overlay" Background="#F224253F" Visibility="Visible">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="780" Margin="40">
    <TextBlock x:Name="OverlaySymbol" Text="✦" Foreground="#F4DFAC" FontSize="80" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
     <TextBlock.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/></TransformGroup></TextBlock.RenderTransform>
    </TextBlock>
    <TextBlock x:Name="OverlayTitle" Text="Even geduld…" FontSize="40" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,14" />
    <TextBlock x:Name="OverlayMessage" Text="Je avonturen komen eraan." Foreground="#D6CEDF" FontSize="24" TextAlignment="Center" TextWrapping="Wrap" />
    <Button x:Name="ReturnButton" Content="Terug naar mijn spelletjes" Visibility="Collapsed" Margin="0,30,0,0" Click="Return_Click" />
   </StackPanel>
  </Border>
 </Grid>
</Window>
