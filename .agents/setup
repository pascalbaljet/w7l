#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$DOTNET_ROOT:$PATH"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1

# The SDK is a compiler only. All shipped applications still target net48/x86.
if [[ ! -d "$DOTNET_ROOT/sdk/8.0.408" ]]; then
  printf 'Installing .NET SDK 8.0.408 for shared-library compilation.\n'
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --silent --show-error --location https://dot.net/v1/dotnet-install.sh -o "$installer"
  bash "$installer" --version 8.0.408 --install-dir "$DOTNET_ROOT" --no-path
fi

marker='# KidLauncher orb compiler'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# KidLauncher orb compiler
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$DOTNET_ROOT:$PATH"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
EOF
fi

printf 'Restoring solution reference assemblies.\n'
dotnet restore "$repo_root/KidLauncher.sln" --verbosity minimal
printf 'The solution can compile here; Windows CI runs WPF and net48 tests.\n'
printf 'Orb setup finished in %s seconds.\n' "$SECONDS"
